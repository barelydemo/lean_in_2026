# ── Story director (LLM) ─────────────────────────────────────────────────
# claude | deepseek | groq | mock (scripted, offline — for UI work and CI)
LLM_PROVIDER=claude
# Optional: retry a failed turn on another provider (e.g. groq)
LLM_FALLBACK=

ANTHROPIC_API_KEY=
# Haiku for fast inference; claude-opus-5-5 for the richest characters
CLAUDE_MODEL=claude-haiku-5-5
# low keeps turns snappy; raise to medium if characters feel shallow
CLAUDE_EFFORT=low
# off ≈ 5s turns on Haiku, adaptive ≈ 13s (default: off on Haiku, adaptive otherwise)
CLAUDE_THINKING=off

DEEPSEEK_API_KEY=
# deepseek-flash is the fast one; deepseek-v4-pro is slower and richer
DEEPSEEK_MODEL=deepseek-flash
# DeepSeek thinks at high effort by default, which makes every turn slow.
# off = fast turns; low | high | max turn thinking back on.
DEEPSEEK_THINKING=off
# DEEPSEEK_BASE_URL=https://api.deepseek.com

GROQ_API_KEY=
# gpt-oss models get strict JSON-schema output; others (e.g. qwen/qwen3.8-27b,
# llama-3.3-70b-versatile) only get JSON mode and fail validation more often.
# Groq's free tier caps request size; the full director prompt needs a paid tier.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# ── Voice ────────────────────────────────────────────────────────────────
# ElevenLabs: character voices + generated music/ambience/sfx (+ STT)
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
# auto reads the stack from the key (…_residency_in → India); or global|us|in|eu
ELEVENLABS_REGION=auto
# Parallel requests your ElevenLabs plan allows (starter plans: 2)
ELEVENLABS_CONCURRENCY=2
# Per-character voices (pick Japanese voices from the Voice Library)
# ELEVENLABS_VOICE_KENJI=
# ELEVENLABS_VOICE_AIKO=
# ELEVENLABS_VOICE_YUMI=
# ELEVENLABS_VOICE_HIROSHI=
# ELEVENLABS_VOICE_EMILY=

# Speech-to-text: elevenlabs | groq | none (default: elevenlabs if keyed, else groq)
STT_PROVIDER=elevenlabs
GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional: Azure Speech Pronunciation Assessment (falls back to STT/Coach proxy if unset)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=japaneast

# Render missing music/ambience/sfx in the background at startup (costs
# ElevenLabs credits once; or run `lexical-server generate-audio`)
AUDIO_AUTOGENERATE=0

# ── Server ───────────────────────────────────────────────────────────────
# Closed beta: making an account needs an invite code.
INVITE_ONLY=true
# Play without an account at all (no sign-in). Off: everyone signs in first.
ALLOW_GUESTS=false
# Comma-separated. These emails become admins on sign-up (no invite needed)
# and can open /admin to invite testers.
ADMIN_EMAILS=
SESSION_DAYS=30
# Courses to serve, from server/content/courses/<id>: ja (Japanese for English
# speakers) and en (English for Japanese speakers).
COURSES=ja,en
# Set to true only behind a reverse proxy that appends X-Forwarded-For.
TRUST_PROXY=false
MAX_TURNS_PER_DAY=400
# DATABASE_URL=sqlite:///data/lexical.db
# LOG_FORMAT=json
# RUST_LOG=info

# ── Production (compose.prod.yml) ───────────────────────────────────────
# The public hostname; Caddy serves https://$DOMAIN and gets its certificate.
# DOMAIN=play.example.com

# ── Public URLs (docker compose) ─────────────────────────────────────────
# Also where beta invite links point.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080

# ── Background art: node scripts/generate-backgrounds.mjs ───────────────
POLLINATIONS_KEY=
