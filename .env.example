# ── Story director (LLM) ─────────────────────────────────────────────────
# deepseek | claude | groq | mock (scripted, offline — for UI work and CI)
LLM_PROVIDER=deepseek
# Optional: retry a failed turn on another provider (e.g. groq)
LLM_FALLBACK=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

ANTHROPIC_API_KEY=
# Haiku for fast inference; claude-opus-5-5 for the richest characters
CLAUDE_MODEL=claude-haiku-5-5
# low keeps turns snappy; raise to medium if characters feel shallow
CLAUDE_EFFORT=low
# off ≈ 5s turns on Haiku, adaptive ≈ 13s (default: off on Haiku, adaptive otherwise)
CLAUDE_THINKING=off

GROQ_API_KEY=
# gpt-oss models get strict JSON-schema output; others use JSON mode
GROQ_MODEL=openai/gpt-oss-120b # e.g. openai/gpt-oss-120b | qwen/qwen3.8-27b | llama-3.3-70b-versatile
GROQ_REASONING_EFFORT=low

# ── Voice & Speech-to-Text (STT) ─────────────────────────────────────────
# Speech-to-text: bolna | groq | elevenlabs | none
STT_PROVIDER=bolna

# Bolna Voice AI (Primary STT & Voice Agent Pipeline)
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_BASE_URL=https://api.bolna.ai
BOLNA_STT_MODEL=deepgram-nova-3

# Groq STT (Fallback Whisper STT)
GROQ_STT_MODEL=whisper-large-v3-turbo

# ElevenLabs: character voices + generated music/ambience/sfx
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
# auto reads the stack from the key (…_residency_in → India); or global|us|in|eu
ELEVENLABS_REGION=auto
# Parallel requests your ElevenLabs plan allows (starter plans: 2)
ELEVENLABS_CONCURRENCY=2
# Per-character voices (pick Japanese voices from the Voice Library)
# ELEVENLABS_VOICE_KENJI=
# ELEVENLABS_VOICE_AIKO=
# ELEVENLABS_VOICE_YUMI=
# ELEVENLABS_VOICE_HIROSHI=
# ELEVENLABS_VOICE_EMILY=

# Optional: Azure Speech Pronunciation Assessment (falls back to STT/Coach proxy if unset)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=japaneast

# Render missing music/ambience/sfx in the background at startup (costs
# ElevenLabs credits once; or run `lexical-server generate-audio`)
AUDIO_AUTOGENERATE=0

# ── Server ───────────────────────────────────────────────────────────────
MAX_TURNS_PER_DAY=400
# DATABASE_URL=sqlite:///data/lexical.db
# LOG_FORMAT=json
# RUST_LOG=info

# ── Public URLs (docker compose) ─────────────────────────────────────────
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080

# ── Background art: node scripts/generate-backgrounds.mjs ───────────────
POLLINATIONS_KEY=
